<?xml version="1.0"?>
<!--
  Camera mount: AgileX's wrist camera stand for the Piper gripper (mesh meshes/realsense_mid_stand.dae, MIT, see meshes/README.md).

  Mount interface (every file in mounts/ defines these, so a mount is chosen by including one of them):
    piper_camera_mount(prefix, parent, mesh, xyz, rpy)
      creates `${prefix}camera_mount_link`, fixed to `parent`; `mesh` overrides the visual mesh ('' = this mount's own, 'none' = a box);
      xyz/rpy are for mounts that take a pose (see mounts/custom.xacro); this preset ignores them.
    properties piper_mount_camera_xyz / piper_mount_camera_rpy: where the camera body sits in `${prefix}camera_mount_link`.

  Poses: config/camera_mounts/agilex_mid_stand.yaml (nominal: AgileX's own numbers from agx_arm_sim `urdf/piper_girpper_D435.urdf`, applied
  to `gripper_base`: the stand is clamped to the gripper body, the official model puts gripper_base 4.5 mm out from link6, user-confirmed
  2026-11-08, CLEANUP C5). A measured pose replaces them: camera_calibration:=<name or path of such a yaml> (piper.urdf.xacro).
  See docs/description/DECISIONS.md D11. To add your own mount (CAD export): copy this file, change the mesh, poses and collision.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- The poses come from config/camera_mounts/agilex_mid_stand.yaml (nominal) or the file given as camera_calibration (measured);
       piper.urdf.xacro redefines piper_mount_calibration before the camera is placed. -->
  <xacro:property name="piper_mount_calibration" value="${xacro.load_yaml('$(find piper_description)/config/camera_mounts/agilex_mid_stand.yaml')}" />
  <xacro:property name="piper_mount_camera_xyz" value="${' '.join(map(str, piper_mount_calibration['camera_in_stand']['xyz']))}" />
  <xacro:property name="piper_mount_camera_rpy" value="${' '.join(map(str, piper_mount_calibration['camera_in_stand']['rpy']))}" />
  <xacro:property name="piper_mount_default_mesh" value="$(find piper_description)/meshes/realsense_mid_stand.dae" />

  <xacro:macro name="piper_camera_mount" params="prefix parent mesh:='' xyz:='0 0 0' rpy:='0 0 0'">
    <xacro:property name="stand_mesh" value="${mesh if mesh else piper_mount_default_mesh}" />
    <link name="${prefix}camera_mount_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.04" />
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" />
      </inertial>
      <xacro:if value="${stand_mesh == 'none'}">
        <visual>
          <origin xyz="-0.018 -0.014 0.002" rpy="0 0 0" />
          <geometry><box size="0.074 0.097 0.048" /></geometry>
          <material name="${prefix}camera_mount_grey"><color rgba="0.35 0.35 0.38 1" /></material>
        </visual>
      </xacro:if>
      <xacro:unless value="${stand_mesh == 'none'}">
        <visual>
          <origin xyz="0 0 0" rpy="-1.57 0 1.57" />
          <geometry><mesh filename="file://${stand_mesh}" /></geometry>
        </visual>
      </xacro:unless>
      <!-- collision: the stand's own shape (meshes/realsense_mid_stand_collision.stl, tools/build_collision_meshes.py) in the visual's frame;
           a box around the stand when another or no stand mesh is chosen (mesh:=none or a path) -->
      <xacro:if value="${mesh == ''}">
        <collision>
          <origin xyz="0 0 0" rpy="-1.57 0 1.57" />
          <geometry><mesh filename="file://$(find piper_description)/meshes/realsense_mid_stand_collision.stl" /></geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${mesh == ''}">
        <collision>
          <origin xyz="-0.018 -0.014 0.002" rpy="0 0 0" />
          <geometry><box size="0.074 0.097 0.048" /></geometry>
        </collision>
      </xacro:unless>
    </link>
    <joint name="${prefix}camera_mount_joint" type="fixed">
      <origin xyz="${' '.join(map(str, piper_mount_calibration['stand_in_gripper_base']['xyz']))}"
              rpy="${' '.join(map(str, piper_mount_calibration['stand_in_gripper_base']['rpy']))}" />
      <parent link="${parent}" />
      <child link="${prefix}camera_mount_link" />
    </joint>
  </xacro:macro>
</robot>
