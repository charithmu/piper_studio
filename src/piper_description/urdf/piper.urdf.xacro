<?xml version="1.0"?>
<!--
  Piper Studio robot description, standalone: the Piper at the world origin, assembled from the pieces below. A carrier robot
  (a Go2, a table, a cell) does not use this file; it includes the pieces it needs and calls them with its own parent link:

    urdf/piper_arm.xacro            piper_arm(parent, prefix, xyz, rpy, gripper)  arm + gripper, generated from the official AgileX
                                    model and validated against it (tools/piper_arm_macro.py; docs/ARCHITECTURE.md, D12)
    urdf/piper.tool.xacro           piper_tool_frames                             TCP frame
    urdf/piper_camera.xacro         piper_camera + one cameras/<model>.xacro and one mounts/<mount>.xacro
    urdf/piper.ros2_control.xacro   piper_ros2_control                            hardware block (backend switch)

  Geometry, limits and inertials come unmodified from the official AgileX model (docs/description/DECISIONS.md).
  Every link, joint and frame name starts with `prefix` (default piper_); prefix:="" gives the official names.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper">
  <!-- mock | real | gazebo | mujoco | isaac -->
  <xacro:arg name="hardware" default="mock" />
  <xacro:arg name="prefix" default="piper_" />
  <xacro:arg name="gripper" default="true" />
  <xacro:arg name="initial_positions_file" default="$(find piper_description)/config/initial_positions.yaml" />
  <!-- TCP offset from gripper_base (gripper) or flange_link (no gripper). The default is the
       fingertip centre: the finger meshes end at z = 0.138 m in gripper_base. -->
  <xacro:arg name="tcp_xyz" default="0 0 0.138" />
  <xacro:arg name="tcp_rpy" default="0 0 0" />
  <!-- Wrist camera: the Stereolabs ZED X Mini on the own clamp bracket, ON BY DEFAULT (cameras/zedxm.xacro, mounts/zedxm_bracket.xacro, piper_camera.xacro).
       camera:=none is the robot only (no camera, no bracket). camera_calibration: a version of the bracket (a name in config/camera_mounts, e.g. zedxm_bracket_v2, or a
       yaml path with a measured pose); empty = the newest version. Lens, image size, field of view, rate: config/camera_models/zedxm.yaml, overridden by the args below. -->
  <xacro:arg name="camera" default="zedxm" />
  <xacro:arg name="camera_calibration" default="" />
  <xacro:arg name="camera_lens" default="" />
  <xacro:arg name="camera_width" default="" />
  <xacro:arg name="camera_height" default="" />
  <xacro:arg name="camera_hfov_deg" default="" />
  <xacro:arg name="camera_rate" default="" />
  <!-- Backend-specific inputs. -->
  <xacro:arg name="controllers_file" default="" />
  <xacro:arg name="mujoco_model" default="" />
  <xacro:arg name="mujoco_headless" default="true" />

  <xacro:property name="prefix" value="$(arg prefix)" />
  <xacro:property name="use_gripper" value="$(arg gripper)" />

  <xacro:include filename="$(find piper_description)/urdf/piper_arm.xacro" />
  <link name="world" />
  <xacro:piper_arm parent="world" prefix="${prefix}" gripper="${use_gripper}" />

  <xacro:include filename="$(find piper_description)/urdf/piper.tool.xacro" />
  <xacro:piper_tool_frames prefix="${prefix}" gripper="${use_gripper}" tcp_xyz="$(arg tcp_xyz)" tcp_rpy="$(arg tcp_rpy)" />

  <xacro:if value="${'$(arg camera)' != 'none'}">
    <xacro:include filename="$(find piper_description)/urdf/cameras/$(arg camera).xacro" />
    <xacro:include filename="$(find piper_description)/urdf/mounts/zedxm_bracket.xacro" />
    <xacro:include filename="$(find piper_description)/urdf/piper_camera.xacro" />
    <xacro:if value="${'$(arg camera_calibration)' != ''}">
      <xacro:property name="piper_mount_calibration"
                      value="${xacro.load_yaml('$(arg camera_calibration)' if '/' in '$(arg camera_calibration)' else '$(find piper_description)/config/camera_mounts/$(arg camera_calibration).yaml')}" />
    </xacro:if>
    <!-- the camera model's numbers; the args override them one by one -->
    <xacro:property name="cam_model" value="${xacro.load_yaml('$(find piper_description)/config/camera_models/$(arg camera).yaml')}" />
    <xacro:property name="cam_lens" value="${'$(arg camera_lens)' or cam_model['lens']}" />
    <xacro:piper_camera prefix="${prefix}" parent="${prefix}gripper_base" hardware="$(arg hardware)"
                        width="${'$(arg camera_width)' or cam_model['image']['width']}" height="${'$(arg camera_height)' or cam_model['image']['height']}"
                        hfov_deg="${'$(arg camera_hfov_deg)' or cam_model['lenses'][cam_lens]['hfov_deg']}"
                        update_rate="${'$(arg camera_rate)' or cam_model['rate']}"
                        near="${cam_model['lenses'][cam_lens]['depth_min']}" far="${cam_model['lenses'][cam_lens]['depth_max']}" />
  </xacro:if>

  <xacro:include filename="$(find piper_description)/urdf/piper.ros2_control.xacro" />
  <xacro:piper_ros2_control
    prefix="${prefix}"
    hardware="$(arg hardware)"
    gripper="${use_gripper}"
    initial_positions_file="$(arg initial_positions_file)"
    controllers_file="$(arg controllers_file)"
    mujoco_model="$(arg mujoco_model)"
    mujoco_headless="$(arg mujoco_headless)"
    camera="$(arg camera)" />
</robot>
