<?xml version="1.0"?>
<!--
  One ros2_control block for every backend. Joint names and interfaces are identical across
  backends so the same controllers.yaml drives mock, real and simulated arms; only the
  hardware plugin changes.

  real: the official agx_arm_ctrl node owns the CAN bus. It publishes measured state on
  feedback/joint_states and accepts position targets on control/joint_states.
  JointStateTopicSystem bridges them into ros2_control so trajectory controllers track measured
  state. Commands go through piper_bringup's command_guard (hw/joint_commands -> control/joint_states),
  which drops NaN (published while no controller is active), out-of-limit and jump commands.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="piper_joint" params="name initial effort:=false">
    <joint name="${name}">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity" />
      <!-- Isaac's joint-state publisher always sends efforts; JointStateTopicSystem needs the interface. -->
      <xacro:if value="${effort}"><state_interface name="effort" /></xacro:if>
    </joint>
  </xacro:macro>

  <xacro:macro name="piper_ros2_control" params="hardware gripper initial_positions_file controllers_file mujoco_model mujoco_headless camera:=none">
    <xacro:property name="init" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}" />
    <xacro:property name="known" value="${['mock', 'real', 'gazebo', 'mujoco', 'isaac']}" />
    <xacro:if value="${hardware not in known}">
      ${xacro.fatal('hardware:=' + hardware + ' is not implemented yet; supported: ' + ', '.join(known))}
    </xacro:if>

    <ros2_control name="PiperSystem" type="system">
      <hardware>
        <xacro:if value="${hardware == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:if value="${hardware == 'real'}">
          <plugin>joint_state_topic_hardware_interface/JointStateTopicSystem</plugin>
          <!-- Relative names so a namespaced launch keeps driver and hardware paired. -->
          <param name="joint_commands_topic">hw/joint_commands</param>
          <param name="joint_states_topic">feedback/joint_states</param>
          <!-- Always forward the controller output; agx_arm_ctrl expects a continuous stream. -->
          <param name="trigger_joint_command_threshold">-1</param>
        </xacro:if>
        <xacro:if value="${hardware == 'gazebo'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:if value="${hardware == 'isaac'}">
          <!-- Isaac Sim runs as a separate process (isaac/run_piper.py) and exchanges joint states and
               position targets over ROS topics, like the real driver. Its own ROS bridge publishes
               /clock. The fingers are driven by the Isaac runner from `gripper`. -->
          <plugin>joint_state_topic_hardware_interface/JointStateTopicSystem</plugin>
          <param name="joint_commands_topic">isaac/joint_commands</param>
          <param name="joint_states_topic">isaac/joint_states</param>
          <param name="trigger_joint_command_threshold">-1</param>
        </xacro:if>
        <xacro:if value="${hardware == 'mujoco'}">
          <!-- MJCF generated from this description by piper_description.mujoco_model();
               the fingers follow `gripper` through MJCF equality constraints. -->
          <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
          <param name="mujoco_model">${mujoco_model}</param>
          <param name="headless">${mujoco_headless}</param>
          <param name="sim_speed_factor">1.0</param>
        </xacro:if>
      </hardware>

      <xacro:piper_joint name="joint1" initial="${init['joint1']}" effort="${hardware == 'isaac'}" />
      <xacro:piper_joint name="joint2" initial="${init['joint2']}" effort="${hardware == 'isaac'}" />
      <xacro:piper_joint name="joint3" initial="${init['joint3']}" effort="${hardware == 'isaac'}" />
      <xacro:piper_joint name="joint4" initial="${init['joint4']}" effort="${hardware == 'isaac'}" />
      <xacro:piper_joint name="joint5" initial="${init['joint5']}" effort="${hardware == 'isaac'}" />
      <xacro:piper_joint name="joint6" initial="${init['joint6']}" effort="${hardware == 'isaac'}" />
      <!-- MuJoCo renders the MJCF camera named "camera" and publishes it through this sensor (topics as the RealSense driver). -->
      <xacro:if value="${hardware == 'mujoco' and camera != 'none'}">
        <sensor name="camera">
          <param name="frame_name">camera_color_optical_frame</param>
          <param name="info_topic">/camera/color/camera_info</param>
          <param name="image_topic">/camera/color/image_raw</param>
          <param name="depth_topic">/camera/aligned_depth_to_color/image_raw</param>
        </sensor>
      </xacro:if>
      <!-- Gripper opening width in metres (official single-DOF model; fingers are URDF mimics). -->
      <xacro:if value="${gripper}">
        <xacro:piper_joint name="gripper" initial="${init['gripper']}" effort="${hardware == 'isaac'}" />
        <!-- Gazebo must be told about the mimic fingers (state interfaces only). Mock and Isaac leave
             them out: the URDF mimic relation (+/-0.5) is enough for ros2_control, and Isaac's runner
             couples the fingers to `gripper` in physics. -->
        <xacro:if value="${hardware == 'gazebo'}">
          <xacro:property name="fe" value="${False}" />
          <joint name="gripper_joint1"><state_interface name="position" /><state_interface name="velocity" />
            <xacro:if value="${fe}"><state_interface name="effort" /></xacro:if></joint>
          <joint name="gripper_joint2"><state_interface name="position" /><state_interface name="velocity" />
            <xacro:if value="${fe}"><state_interface name="effort" /></xacro:if></joint>
        </xacro:if>
      </xacro:if>
    </ros2_control>

    <xacro:if value="${hardware == 'gazebo'}">
      <xacro:if value="${controllers_file == ''}">
        ${xacro.fatal('hardware:=gazebo needs controllers_file:=/path/to/controllers.yaml')}
      </xacro:if>
      <!-- The controller manager runs inside Gazebo; the fingers follow `gripper` via URDF mimic. -->
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>${controllers_file}</parameters>
        </plugin>
        <!-- Simulator ground truth for every joint, including the mimic fingers (gz topic .../joint_state). -->
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher" />
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
