<!--
  Wrist camera: Intel RealSense D435 on AgileX's camera stand, mounted on the Piper gripper. The stand mesh and the poses
  are AgileX's own, from agx_arm_sim `urdf/piper_girpper_D435.urdf` (MIT; see meshes/README.md), which uses the same link
  frames as the official model we include:
    link6 -> camera_bracket_link (the stand)   xyz -0.034 -0.001 0.022
    camera_bracket_link -> camera (D435)       xyz -0.031 -0.028 0.0018, rpy 0 -1.22 0   (tilted toward the fingers)
  The camera sits on the -x side of the gripper, across from nothing: the fingers open along +-y, so they appear
  symmetrically left and right in the image. (Until 2026-11-07 the pose of the older piper_isaac_sim description was used
  unrotated and put the camera on the +y side, in line with one finger; see docs/description/DECISIONS.md D11.)
  The D435 frames come from realsense2_description (Apache-2.0, modified copy piper.d435.xacro); its coloured mesh is built from MuJoCo Menagerie realsense_d435i (Apache-2.0). Set camera_bracket_mesh:=/path/to.dae to use another stand mesh,
  or camera_bracket_mesh:=none for a plain box.

  Frames (names as published by the realsense2_camera driver): camera_link, camera_color_frame,
  camera_color_optical_frame (z forward), camera_depth_optical_frame. Depth is aligned to color in simulation.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find piper_description)/urdf/piper.d435.xacro" />

  <xacro:macro name="piper_camera" params="parent hardware bracket_mesh width height hfov_deg update_rate">
    <xacro:piper_d435 parent="camera_bracket_link" name="camera" use_nominal_extrinsics="true" use_mesh="true">
      <origin xyz="-0.031 -0.028 0.0018" rpy="0 -1.22 0" />
    </xacro:piper_d435>

    <link name="camera_bracket_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.04" />
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" />
      </inertial>
      <xacro:if value="${bracket_mesh == 'none'}">
        <visual>
          <origin xyz="-0.018 -0.014 0.002" rpy="0 0 0" />
          <geometry><box size="0.074 0.097 0.048" /></geometry>
          <material name="bracket_grey"><color rgba="0.35 0.35 0.38 1" /></material>
        </visual>
      </xacro:if>
      <xacro:unless value="${bracket_mesh == 'none'}">
        <visual>
          <origin xyz="0 0 0" rpy="-1.57 0 1.57" />
          <geometry><mesh filename="file://${bracket_mesh}" /></geometry>
        </visual>
      </xacro:unless>
      <!-- collision: bounding box of the stand mesh in the stand frame -->
      <collision>
        <origin xyz="-0.018 -0.014 0.002" rpy="0 0 0" />
        <geometry><box size="0.074 0.097 0.048" /></geometry>
      </collision>
    </link>
    <joint name="camera_bracket_joint" type="fixed">
      <origin xyz="-0.034 -0.001 0.022" rpy="0 0 0" />
      <parent link="${parent}" />
      <child link="camera_bracket_link" />
    </joint>

    <!-- Simulated image sensors (Gazebo). MuJoCo and Isaac define theirs in their own model/runner. The sensor looks along
         x of camera_color_frame (plus the lens offset below); the bridge republishes the images as ROS topics. -->
    <xacro:if value="${hardware == 'gazebo'}">
      <gazebo reference="camera_color_frame">
        <sensor name="camera" type="rgbd_camera">
          <always_on>1</always_on>
          <update_rate>${update_rate}</update_rate>
          <visualize>0</visualize>
          <topic>camera</topic>
          <!-- Lens plane: camera_color_frame lies inside the D435 housing mesh, so a sensor there sees only its own
               housing (uniform background). Moving it 4 cm along its viewing axis puts it in front of the glass. -->
          <pose>0.04 0 0 0 0 0</pose>
          <gz_frame_id>camera_color_optical_frame</gz_frame_id>
          <camera>
            <horizontal_fov>${hfov_deg * 3.14159265359 / 180.0}</horizontal_fov>
            <image><width>${width}</width><height>${height}</height></image>
            <clip><near>0.07</near><far>6.0</far></clip>
            <depth_camera><clip><near>0.1</near><far>6.0</far></clip></depth_camera>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
