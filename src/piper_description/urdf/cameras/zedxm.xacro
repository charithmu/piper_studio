<?xml version="1.0"?>
<!--
  Camera model: Stereolabs ZED X Mini (GMSL2, run on a ZED Box). Built after Stereolabs' own description, so the frames are the ones the ZED wrapper expects:
  https://github.com/stereolabs/zed-ros2-description (urdf/zed_macro.urdf.xacro, model zedxm, commit 2246824, Apache-2.0, copyright Stereolabs;
  mesh meshes/zedxm.stl used for visual and collision, like Stereolabs does). Interface: piper_camera_model(prefix, parent, hardware, width, height, hfov_deg, update_rate, near, far, *origin).

  Stereolabs' frames, with name = `${prefix}zed` (what the wrapper gets as camera_name:=piper_zed):
    ${prefix}zed_camera_link                 the threaded screw hole in the bottom of the camera = the mesh origin = `origin` (the pose from the mount yaml); x forward, y left, z up
    ${prefix}camera_link                     Stereolabs' `<name>_camera_center`: 16 mm above the screw point, carries the mesh. Named camera_link here because that is the contract's frame (docs/INTEGRATION.md)
    ${prefix}zed_left_camera_frame           5 mm behind the centre, 25 mm to the left (baseline 50 mm);  ..._optical: z forward, x right, y down
    ${prefix}zed_right_camera_frame          5 mm behind the centre, 25 mm to the right;                  ..._optical
  Contract aliases (identity): camera_color_frame = zed_left_camera_frame, camera_color_optical_frame = zed_left_camera_frame_optical, camera_depth_optical_frame = the same
  (ZED depth is registered to the left image).
  The ZED wrapper publishes TF of its own: run it with its TF off, or it fights this description (one description only).
  hfov_deg / width / height / near / far: from config/camera_models/zedxm.yaml (the lens and image mode), overridable in piper.urdf.xacro.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="zedxm_baseline" value="0.05" />
  <xacro:property name="zedxm_height" value="0.032" />
  <xacro:property name="zedxm_optical_offset_x" value="-0.005" />
  <xacro:macro name="piper_camera_model" params="prefix parent hardware width height hfov_deg update_rate near:=0.1 far:=8.0 *origin">
    <joint name="${prefix}zed_camera_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${prefix}zed_camera_link" />
    </joint>
    <link name="${prefix}zed_camera_link" />

    <joint name="${prefix}camera_center_joint" type="fixed">
      <parent link="${prefix}zed_camera_link" />
      <child link="${prefix}camera_link" />
      <origin xyz="0 0 ${zedxm_height / 2}" rpy="0 0 0" />
    </joint>
    <link name="${prefix}camera_link">
      <visual>
        <origin xyz="0 0 ${-zedxm_height / 2}" rpy="0 0 0" />
        <geometry><mesh filename="file://$(find piper_description)/meshes/zedxm.stl" /></geometry>
        <material name="${prefix}zedxm_grey"><color rgba="0.25 0.25 0.25 1" /></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${-zedxm_height / 2}" rpy="0 0 0" />
        <geometry><mesh filename="file://$(find piper_description)/meshes/zedxm.stl" /></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.008 0 0" rpy="0 0 0" />
        <mass value="0.150" />
        <inertia ixx="1.222e-4" ixy="0" ixz="0" iyy="4.07e-5" iyz="0" izz="1.376e-4" />   <!-- solid box 47.4 x 93.6 x 31.8 mm (x forward, y across, z up), 150 g -->
      </inertial>
    </link>

    <joint name="${prefix}zed_left_camera_joint" type="fixed">
      <parent link="${prefix}camera_link" /><child link="${prefix}zed_left_camera_frame" />
      <origin xyz="${zedxm_optical_offset_x} ${zedxm_baseline / 2} 0" rpy="0 0 0" />
    </joint>
    <link name="${prefix}zed_left_camera_frame" />
    <joint name="${prefix}zed_left_camera_optical_joint" type="fixed">
      <parent link="${prefix}zed_left_camera_frame" /><child link="${prefix}zed_left_camera_frame_optical" />
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    </joint>
    <link name="${prefix}zed_left_camera_frame_optical" />
    <joint name="${prefix}zed_right_camera_joint" type="fixed">
      <parent link="${prefix}camera_link" /><child link="${prefix}zed_right_camera_frame" />
      <origin xyz="${zedxm_optical_offset_x} ${-zedxm_baseline / 2} 0" rpy="0 0 0" />
    </joint>
    <link name="${prefix}zed_right_camera_frame" />
    <joint name="${prefix}zed_right_camera_optical_joint" type="fixed">
      <parent link="${prefix}zed_right_camera_frame" /><child link="${prefix}zed_right_camera_frame_optical" />
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    </joint>
    <link name="${prefix}zed_right_camera_frame_optical" />

    <!-- contract aliases -->
    <joint name="${prefix}camera_color_joint" type="fixed">
      <parent link="${prefix}zed_left_camera_frame" /><child link="${prefix}camera_color_frame" /><origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    <link name="${prefix}camera_color_frame" />
    <joint name="${prefix}camera_color_optical_joint" type="fixed">
      <parent link="${prefix}zed_left_camera_frame_optical" /><child link="${prefix}camera_color_optical_frame" /><origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    <link name="${prefix}camera_color_optical_frame" />
    <joint name="${prefix}camera_depth_optical_joint" type="fixed">
      <parent link="${prefix}zed_left_camera_frame_optical" /><child link="${prefix}camera_depth_optical_frame" /><origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    <link name="${prefix}camera_depth_optical_frame" />

    <!-- Simulated sensor (Gazebo) on the left lens; the lens frame is inside the housing (front glass 20 mm ahead), so the sensor sits 25 mm in front of it -->
    <xacro:if value="${hardware == 'gazebo'}">
      <gazebo reference="${prefix}camera_color_frame">
        <sensor name="camera" type="rgbd_camera">
          <always_on>1</always_on>
          <update_rate>${update_rate}</update_rate>
          <visualize>0</visualize>
          <topic>camera</topic>
          <pose>0.025 0 0 0 0 0</pose>
          <gz_frame_id>${prefix}camera_color_optical_frame</gz_frame_id>
          <camera>
            <horizontal_fov>${hfov_deg * pi / 180.0}</horizontal_fov>
            <image><width>${width}</width><height>${height}</height></image>
            <clip><near>${near}</near><far>${far}</far></clip>
            <depth_camera><clip><near>${near}</near><far>${far}</far></clip></depth_camera>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
