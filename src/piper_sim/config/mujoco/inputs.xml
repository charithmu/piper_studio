<!--
  MuJoCo additions to the generated model (mujoco_ros2_control make_mjcf_from_robot_description.py).
  Kinematics, limits and inertials come from piper_description; only simulator-specific actuation,
  constraints and solver settings live here.

  The actuators and solver options are NOT written here: <!--ACTUATORS--> and <!--OPTION--> are filled by piper_sim.apply_actuation()
  from piper_description/config/actuation.yaml (the one source for MuJoCo and Isaac): position servos with gravity compensation standing in for
  the firmware's position loop, force limits = the description's joint efforts (firmware_values.yaml). Actuator names equal the ros2_control joint names.
-->
<mujoco_inputs>
  <raw_inputs>
    <!--OPTION-->

    <default>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom group="3" type="mesh"/>
      </default>
    </default>

    <!--ACTUATORS-->

    <!-- The fixed base is fused into the world body, and MuJoCo does not filter parent-child
         contacts when the parent is the world: without this, link1 rubs on the base and cannot turn. -->
    <contact>
      <exclude body1="world" body2="${prefix}link1"/>
      <!-- Finger collision meshes meet at width 0 (the official SRDF disables this pair too);
           without this a closing gripper stalls a few millimetres short of closed. -->
      <exclude body1="${prefix}gripper_link1" body2="${prefix}gripper_link2"/>
    </contact>

    <!-- URDF mimic relations: gripper_joint1 = 0.5 * gripper, gripper_joint2 = -0.5 * gripper. -->
    <equality>
      <joint joint1="${prefix}gripper_joint1" joint2="${prefix}gripper" polycoef="0 0.5 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
      <joint joint1="${prefix}gripper_joint2" joint2="${prefix}gripper" polycoef="0 -0.5 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    </equality>
  </raw_inputs>

  <processed_inputs>
    <modify_element type="body" name="${prefix}link1" gravcomp="1"/>
    <modify_element type="body" name="${prefix}link2" gravcomp="1"/>
    <modify_element type="body" name="${prefix}link3" gravcomp="1"/>
    <modify_element type="body" name="${prefix}link4" gravcomp="1"/>
    <modify_element type="body" name="${prefix}link5" gravcomp="1"/>
    <modify_element type="body" name="${prefix}link6" gravcomp="1"/>
    <modify_element type="body" name="${prefix}gripper_link" gravcomp="1"/>
    <modify_element type="body" name="${prefix}gripper_link1" gravcomp="1"/>
    <modify_element type="body" name="${prefix}gripper_link2" gravcomp="1"/>
  </processed_inputs>
</mujoco_inputs>
