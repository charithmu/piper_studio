<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>piper_sim</name>
  <version>0.1.0</version>
  <description>Piper simulators (Gazebo Harmonic, MuJoCo, Isaac Sim): models generated from piper_description, scenes, and the all-in-one launch (backend:=mock|real|gazebo|mujoco|isaac). Internal to this repo: not meant to be imported by other projects.</description>
  <maintainer email="mung@zhaw.ch">Charith Munasinghe</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>piper_description</exec_depend>
  <exec_depend>piper_control</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>mujoco_ros2_control</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
