<?xml version="1.0"?>
<!-- Official agx_arm_moveit semantics (groups, end effector, collision matrix) plus Piper Studio named poses. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg robot_name)">
  <!-- must equal the name of the URDF MoveIt loads, or MoveIt ignores this file (and the collision matrix with it) -->
  <xacro:arg name="robot_name" default="piper" />
  <xacro:arg name="prefix" default="piper_" />
  <xacro:arg name="gripper" default="true" />
  <xacro:arg name="camera" default="none" />
  <xacro:property name="prefix" value="$(arg prefix)" />
  <!-- groups, passive joints, end effector, official named poses and collision matrix: generated from the official SRDF, prefixed -->
  <xacro:include filename="$(find piper_control)/config/moveit/piper_official.srdf.xacro" />
  <xacro:piper_official_srdf prefix="${prefix}" gripper="$(arg gripper)" />

  <xacro:if value="${'$(arg camera)' != 'none'}">
    <!-- wrist camera and its mount are rigidly attached to gripper_base -->
    <xacro:macro name="never" params="a b"><disable_collisions link1="${prefix}${a}" link2="${prefix}${b}" reason="Adjacent" /></xacro:macro>
    <xacro:never a="camera_link" b="link6" /> <xacro:never a="camera_link" b="link5" />
    <xacro:never a="camera_link" b="flange_link" /> <xacro:never a="camera_link" b="gripper_base" />
    <xacro:never a="camera_link" b="camera_mount_link" />
    <xacro:never a="camera_mount_link" b="link6" /> <xacro:never a="camera_mount_link" b="link5" />
    <xacro:never a="camera_mount_link" b="flange_link" /> <xacro:never a="camera_mount_link" b="gripper_base" />
  </xacro:if>

  <!-- zero: the one valid start and end pose of every session: every joint 0, with joint2/joint3 0.01 rad inside their limits (their limits
       are 0; a pose exactly on a limit is rejected by planners and unreachable for the arm; 0.01 = the guard's limit_margin).
       Equals config/initial_positions.yaml and piper_core.zero_pose (test_named_poses). -->
  <group_state name="zero" group="arm">
    <joint name="${prefix}joint1" value="0" />
    <joint name="${prefix}joint2" value="0.01" />
    <joint name="${prefix}joint3" value="-0.01" />
    <joint name="${prefix}joint4" value="0" />
    <joint name="${prefix}joint5" value="0" />
    <joint name="${prefix}joint6" value="0" />
  </group_state>
  <!-- park: Piper Studio internal (real arm stop sequence, not offered to downstream users): zero with joint5 lowered 22.0 deg (chosen on the real
       arm 2026-11-10: below every slumped j5 seen, 22.7-24 deg), so the wrist hangs about 1 cm above the support brackets and powering off drops the arm only a little.
       Reached from zero by Piper.stop(). Not the slumped pose (what a powered-off arm sags into, outside the limits). -->
  <group_state name="park" group="arm">
    <joint name="${prefix}joint1" value="0" />
    <joint name="${prefix}joint2" value="0.01" />
    <joint name="${prefix}joint3" value="-0.01" />
    <joint name="${prefix}joint4" value="0" />
    <joint name="${prefix}joint5" value="0.3840" />
    <joint name="${prefix}joint6" value="0" />
  </group_state>
  <!-- Elbow up, tool pointing down over the area in front of the base. -->
  <group_state name="ready" group="arm">
    <joint name="${prefix}joint1" value="0" />
    <joint name="${prefix}joint2" value="1.0" />
    <joint name="${prefix}joint3" value="-1.0" />
    <joint name="${prefix}joint4" value="0" />
    <joint name="${prefix}joint5" value="1.0" />
    <joint name="${prefix}joint6" value="0" />
  </group_state>
</robot>
