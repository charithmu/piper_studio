<?xml version="1.0"?>
<!-- Official agx_arm_moveit semantics (groups, end effector, collision matrix) plus Piper Studio named poses. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper">
  <xacro:arg name="arm_type" default="piper" />
  <xacro:arg name="effector_type" default="agx_gripper" />
  <xacro:arg name="revo2_type" default="left" />
  <xacro:arg name="camera" default="none" />
  <xacro:include filename="$(find agx_arm_moveit)/config/agx_arm.srdf.xacro" />

  <xacro:if value="${'$(arg camera)' != 'none'}">
    <!-- wrist camera and its bracket are rigidly mounted on link6 -->
    <xacro:macro name="never" params="a b"><disable_collisions link1="${a}" link2="${b}" reason="Adjacent" /></xacro:macro>
    <xacro:never a="camera_link" b="link6" /> <xacro:never a="camera_link" b="link5" />
    <xacro:never a="camera_link" b="flange_link" /> <xacro:never a="camera_link" b="gripper_base" />
    <xacro:never a="camera_link" b="camera_bracket_link" />
    <xacro:never a="camera_bracket_link" b="link6" /> <xacro:never a="camera_bracket_link" b="link5" />
    <xacro:never a="camera_bracket_link" b="flange_link" /> <xacro:never a="camera_bracket_link" b="gripper_base" />
  </xacro:if>

  <!-- zero: all joints 0, with joint2/joint3 0.01 rad inside their hard stops (matches config/initial_positions.yaml). Start and end pose of every simulation. -->
  <group_state name="zero" group="arm">
    <joint name="joint1" value="0" />
    <joint name="joint2" value="0.01" />
    <joint name="joint3" value="-0.01" />
    <joint name="joint4" value="0" />
    <joint name="joint5" value="0" />
    <joint name="joint6" value="0" />
  </group_state>
  <!-- rest: zero with joint5 lowered 16.82 deg (recorded on the real arm 2026-10-14): the wrist hangs just above the support brackets, so
       disabling the motors there drops the arm only a few millimetres. Reach it from zero (piper rest does). -->
  <group_state name="rest" group="arm">
    <joint name="joint1" value="0" />
    <joint name="joint2" value="0.01" />
    <joint name="joint3" value="-0.01" />
    <joint name="joint4" value="0" />
    <joint name="joint5" value="0.2936" />
    <joint name="joint6" value="0" />
  </group_state>
  <!-- Elbow up, tool pointing down over the area in front of the base. -->
  <group_state name="ready" group="arm">
    <joint name="joint1" value="0" />
    <joint name="joint2" value="1.0" />
    <joint name="joint3" value="-1.0" />
    <joint name="joint4" value="0" />
    <joint name="joint5" value="1.0" />
    <joint name="joint6" value="0" />
  </group_state>
</robot>
